# 全部后端服务共用的环境变量（本地开发）。复制为 backend/.env 后填值；.env 不入库。
# 各服务的 Makefile 会自动读取它（make run / make migrate 等），部署时对应一份共享的 Secret / env 文件。
#
# 格式：KEY=value，值不加引号（make 与 docker --env-file 都按字面读取）；值里不能有 # 和 $。
# 这里没写的变量沿用当前 shell 里已经 export 的值。
#
# 配置的加载顺序：kit/bootstrap/shared.yaml（共享基线）→ 各服务 configs/config.yaml → 本文件的环境变量。

# ── 全部服务必须一致 ─────────────────────────────────────────────────────────
# 数据库（全部服务同库）。生产环境各服务用各自的角色成员账号，主机与库名相同、账号不同：
# 在各自的部署里单独覆盖这一项即可。
KRATOS_DATA_DATABASE_SOURCE=host=127.0.0.1 user=postgres password=<口令> dbname=reborn port=5432 sslmode=disable TimeZone=Asia/Shanghai
# 凭据加密主密钥（openssl rand -hex 32）。各服务启动时按 system_key_check 表里的指纹核对。
KRATOS_NOTIFY_MASTER_KEY=

# ── core 与 k8s 数据面必须一致 ───────────────────────────────────────────────
# 内部身份头签名密钥，至少 32 字节（openssl rand -hex 32）。
KRATOS_K8S_INTERNAL_KEY=

# ── 仅 core ─────────────────────────────────────────────────────────────────
# JWT 签名密钥（openssl rand -hex 32）。
KRATOS_SECURITY_JWT_SECRET=
# 智能助手模型密钥；留空 = 助手停用。
#KRATOS_ASSISTANT_API_KEY=
# 知识库向量化服务密钥（OpenAI 兼容 embeddings 端点）；留空 = 不向量化，检索只走全文。
#KRATOS_KNOWLEDGE_EMBEDDING_API_KEY=
# S3 兼容对象存储凭据（data.upload.driver: s3 时需要）。
#KRATOS_DATA_UPLOAD_S3_ACCESS_KEY=
#KRATOS_DATA_UPLOAD_S3_SECRET_KEY=

# ── 仅 k8s 数据面 ───────────────────────────────────────────────────────────
# core 访问本实例的地址；留空 = http://<主机名>:8060。本机主机名解析不了时（macOS 的 *.local 常见）
# 本地开发写回环地址；多实例部署时每个实例在各自的部署里填自己的可达地址，不要放进共享的 Secret。
#KRATOS_SERVER_HTTP_ADVERTISE_ADDR=http://127.0.0.1:8060

# ── 仅 job 的执行节点（runner 角色）──────────────────────────────────────────
#KRATOS_RUNNER_ENGINE_URL=http://127.0.0.1:8051
#KRATOS_RUNNER_TOKEN=
#KRATOS_RUNNER_WORK_DIR=/dev/shm/reborn-job
