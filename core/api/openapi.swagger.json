{
  "swagger": "2.0",
  "info": {
    "title": "monitor core API",
    "description": "system 域用户/角色管理 + 认证接口。由 proto + google.api.http 注解自动生成，proto 为唯一事实来源，勿手改。",
    "version": "v1"
  },
  "tags": [
    {
      "name": "RoleService",
      "description": "RoleService 角色管理服务。"
    },
    {
      "name": "UserService",
      "description": "UserService 用户管理服务：用户 CRUD、状态、密码重置与角色绑定。"
    },
    {
      "name": "AuthService",
      "description": "AuthService 认证服务：登录签发双令牌、刷新轮换、登出吊销与当前登录者信息。\n登录类路由独立于 /api/v1/system/ 域前缀（跨域入口）；除 Login/RefreshToken\n外的全部接口（含本服务的 Logout/GetLoginProfile）均要求 Bearer access token。"
    },
    {
      "name": "SystemConfigService",
      "description": "SystemConfigService 系统配置服务：全局展示配置（系统标题/子标题/logo/\n页脚文案）的单例读写。GetSystemConfig 匿名可读（登录页需在登录前拉取\n标题与 logo），UpdateSystemConfig 需登录且按接口授权判定（仅 admin 或\n被授权角色可调）。"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "summary": "Login 登录：校验用户名密码，签发 access + refresh 双令牌。\n用户不存在与密码错误统一返回 INVALID_CREDENTIALS，不区分口径以防枚举。",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/logout": {
      "post": {
        "summary": "Logout 登出：吊销当前用户全部刷新令牌；用户身份取自 Bearer token。",
        "operationId": "AuthService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LogoutResponse"
            }
