# ==============================================
# Go 语言相关
# ==============================================

# 编译产物 / 二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制（go test -c 生成）
*.test

# go test 覆盖率输出（-coverprofile / -o）
*.out
coverage.txt
coverage.html

# pprof 性能分析文件
*.prof

# 构建输出目录
bin/
dist/
_output/
build/

# 本地开发用 Go workspace 文件
go.work
go.work.sum

# ==============================================
# macOS 操作系统相关
# ==============================================

# Finder 目录元数据
.DS_Store
.AppleDouble
.LSOverride

# 资源分叉文件（网络卷 / U 盘拷贝产生）
._*

# 系统卷宗标记
.Spotlight-V100
.Trashes

# ==============================================
# VSCode 编辑器相关
# ==============================================

# 工作区配置（个人编辑器偏好，不入库）
.vscode/

# 工作区文件
*.code-workspace

# 本地历史记录插件
.history/

# ==============================================
# 项目文档目录
# ==============================================
docs/
