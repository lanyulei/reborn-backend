{
  "swagger": "2.0",
  "info": {
    "title": "notify pipeline ingress API",
    "description": "通知管道数据面接入接口（HMAC 鉴权）。由 proto + google.api.http 注解自动生成，proto 为唯一事实来源，勿手改。",
    "version": "v1"
  },
  "tags": [
    {
      "name": "NotifyIngressService",
      "description": "NotifyIngressService 通知管道数据面接入服务（设计 §6.2）：外部生产者经\nHMAC 鉴权（Authorization: HMAC \u003cproducer_id\u003e:\u003csig\u003e:\u003cts\u003e，±5min 防重放，\n签名绑定请求体）投递事件；先落库后应答——200 即「此刻起消息绝不丢」\n（§7.1 第一道防线）。dedup_key 门闩幂等：重复事件返回首次落库的 event_id\n与 deduplicated=true。数据面只暴露 HTTP（签名绑定请求体，gRPC 无法等价绑定）。"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/ingress/v1/events": {
      "post": {
        "summary": "SendEvent 投递单条事件。",
        "operationId": "NotifyIngressService_SendEvent",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/SendEventResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SendEventRequest"
            }
          }
        ],
        "tags": [
          "NotifyIngressService"
        ]
      }
    },
    "/ingress/v1/events:batch": {
      "post": {
        "summary": "BatchSend 批量投递（≤500 条，同一事务落库：全部成功或全部失败）。",
        "operationId": "NotifyIngressService_BatchSend",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/BatchSendResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchSendRequest"
            }
          }
        ],
        "tags": [
          "NotifyIngressService"
        ]
      }
    }
  },
  "definitions": {
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "BatchSendRequest": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/IngressEvent"
          },
          "title": "events 事件列表，1-500 条。"
        }
      },
      "title": "BatchSendRequest 批量投递请求。"
    },
    "BatchSendResponse": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/SendEventResponse"
          },
          "title": "results 逐条结果。"
        }
      },
      "title": "BatchSendResponse 批量投递响应：results 与请求 events 一一对应。"
    },
    "IngressEvent": {
      "type": "object",
      "properties": {
        "bizId": {
          "type": "string",
          "title": "biz_id 业务命名空间；须与生产者 token 绑定的 biz 一致（scope 校验）。"
        },
        "eventType": {
          "type": "string",
          "title": "event_type 事件类型：小写点分事件名（如 monitor.alert.firing），非路由模式。"
        },
        "severity": {
          "type": "integer",
          "format": "int32",
          "title": "severity 严重级：1 info / 2 warning / 3 critical / 4 fatal。"
        },
        "title": {
          "type": "string",
          "title": "title 事件标题，1-255 字符。"
        },
        "payload": {
          "type": "string",
          "format": "byte",
          "title": "payload 事件载荷：合法 JSON 文本，≤32KB（对象形态便于模板按字段引用）。"
        },
        "dedupKey": {
          "type": "string",
          "title": "dedup_key 重复指纹（可选）：(biz_id, dedup_key) 在门闩有效期内幂等。"
        },
        "groupKey": {
          "type": "string",
          "title": "group_key 聚合分组键（可选）：命中聚合路由时同键事件微批合并。"
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "recipients 显式收件（可选，≤20）：email 渠道以此替代路由收件策略。"
        }
      },
      "title": "IngressEvent 是生产者投递的事件载荷（与 notify_event 运行表字段对齐）。"
    },
    "SendEventRequest": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/definitions/IngressEvent",
          "title": "event 事件载荷。"
        }
      },
      "title": "SendEventRequest 单条投递请求。"
    },
    "SendEventResponse": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "title": "event_id 落库事件标识（dedup 命中时为首次落库的事件）。"
        },
        "deduplicated": {
          "type": "boolean",
          "title": "deduplicated 是否命中 dedup 门闩（true=未新建事件）。"
        }
      },
      "title": "SendEventResponse 单条投递响应。"
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    }
  }
}
